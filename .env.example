# ==============================================================================
# CHAIWALE Admin & Operations Portal - Environment Configuration
# Template File: admin/.env.example
# ==============================================================================

# Central Authoritative Backend API Endpoint
NEXT_PUBLIC_BACKEND_URL=https://api.chaiwale.co.in

# Admin Portal URL
NEXT_PUBLIC_ADMIN_URL=https://admin.chaiwale.co.in

# ------------------------------------------------------------------------------
# SECURITY NOTICE:
# - ONLY browser-safe variables prefixed with NEXT_PUBLIC_ may be added here.
# - The Admin portal browser communicates EXCLUSIVELY with the backend API.
# - NEVER place SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, RESEND_API_KEY,
#   or database credentials inside admin environment variables.
# - Role-based authorization is enforced on every request by the backend API.
# ------------------------------------------------------------------------------
